# Copiez ce fichier en `.env` et remplissez-le UNIQUEMENT si vous passez en trading réel.
# Le fichier `.env` est ignoré par git : vos clés ne seront jamais publiées.
#
# Le mode par défaut du bot est le PAPER TRADING (argent fictif) : aucune clé n'est nécessaire.

# Clés API de l'exchange (ex. Binance, Kraken...). Créez-les avec les droits "trade" seulement,
# JAMAIS le droit de retrait (withdraw).
TRADINGBOT_API_KEY=
TRADINGBOT_API_SECRET=

# Optionnel : notifications Telegram (créez un bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
